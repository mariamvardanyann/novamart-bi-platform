# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# IDE / editor
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Build / packaging
build/
dist/
*.egg-info/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
~$*
*.bak

# Generated datasets
# Keep code/specifications in Git and regenerate data locally.
data/raw/*
data/processed/*
data/quarantine/*
data/generated/*

# Preserve empty data folders if .gitkeep files are used
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/quarantine/.gitkeep
!data/generated/.gitkeep

# Common large generated data files
*.parquet
*.feather
*.pkl
*.pickle

# If CSV files are generated and large, uncomment:
# *.csv

# SQL Server local database / backup files
*.mdf
*.ldf
*.bak
*.trn

# Power BI temporary/cache files
*.pbitmp
*.pbix.tmp
*.pbix.autosave

# Keep the final .pbix report in Git.
# Do not add *.pbix here unless you intentionally want to exclude it.

# Local scratch/output folders
output/
outputs/
tmp/
temp/

# Test artifacts
coverage.xml
junit.xml

# Archived MySQL files
sql/mysql_archive/
